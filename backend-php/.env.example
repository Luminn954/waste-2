# Copy to .env for local XAMPP settings. Never commit the real .env file.
SMARTWASTE_DB_HOST=127.0.0.1
SMARTWASTE_DB_PORT=3306
SMARTWASTE_DB_NAME=smart_waste
SMARTWASTE_DB_USER=root
SMARTWASTE_DB_PASSWORD=

# Keep disabled outside local debugging. Detailed server errors are otherwise hidden from clients.
SMARTWASTE_DEBUG=0

# Local demo only: also seeds user/12345 and sample reports when set to 1.
SMARTWASTE_SEED_DEMO_USER=0

# Used only to create the first admin when the database has no admin account. Use 8+ characters.
SMARTWASTE_BOOTSTRAP_ADMIN_PASSWORD=

# Petugas assistant. Keep the real key in backend-php/.env or the server environment only.
SMARTWASTE_OPENAI_API_KEY=
SMARTWASTE_OPENAI_MODEL=gpt-4o-mini
